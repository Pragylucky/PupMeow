# Copy to .env.local for local dev. On Vercel, set the same keys under Project → Environment Variables.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL (local: http://localhost:3000 | production: https://pupmeow.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI — optional; leave empty to hide Kaia
AI_PROVIDER=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
