# Copy to .env.local for local dev. On Vercel, set the same keys under Project → Environment Variables.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL (local: http://localhost:3000 | production: https://pupmeow.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — shows Instagram in footer and contact (full URL)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/pupmeow.in

# ——— Kaia (paste on Vercel too; not NEXT_PUBLIC_*) ———
# Tip: omit AI_PROVIDER on Vercel — use GROQ_API_KEY + GOOGLE_GENERATIVE_AI_API_KEY only.
# Default try order: groq → cerebras (optional) → google → openai → xai
# Default: Groq then Gemini, one at a time (stable). AI_CHAT_RACE=true enables parallel race (faster, can glitch).
# AI_CHAT_TRY_ORDER=groq,google

# Groq — https://console.groq.com/keys (default in app: qwen/qwen3.8-27b; do not use retired llama-3.3-70b-versatile)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Cerebras (optional) — https://cloud.cerebras.ai (default: qwen-3.8-27b)
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=qwen-3.8-27b

# Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-3.8-flash

# Optional
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# Cost savers (optional): AI_ENABLED=false hides Kaia but keeps keys for later
# AI_MODERATION_LLM=false — heuristics only on posts (no LLM per post)
# AI_LOST_MATCHING=false — skip vision+embeddings on lost/found
# AI_DAILY_LIMIT=15 — lower Kaia cap (max 30 unless you change the DB function)
