# Copy to .env.local for local dev. On Vercel, set the same keys under Project → Environment Variables.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL (local: http://localhost:3000 | production: https://pupmeow.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — shows Instagram in footer and contact (full URL)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/pupmeow.in

# Kaia (Gemini) — required on Vercel for /assistant (not NEXT_PUBLIC_*)
AI_PROVIDER=google
# From https://aistudio.google.com/apikey — usually starts with AIzaSy
GOOGLE_GENERATIVE_AI_API_KEY=
# Aliases also work: GEMINI_API_KEY or GOOGLE_API_KEY (synced to the name above at runtime)
OPENAI_API_KEY=
# Cost savers (optional): AI_ENABLED=false hides Kaia but keeps keys for later
# AI_MODERATION_LLM=false — heuristics only on posts (no LLM per post)
# AI_LOST_MATCHING=false — skip vision+embeddings on lost/found
# AI_DAILY_LIMIT=15 — lower Kaia cap (max 30 unless you change the DB function)
