{
  "name": "pupmeow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.ts",
    "seed": "tsx scripts/seed.ts",
    "remove-seed": "tsx scripts/remove-seed.ts",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preflight": "npm run typecheck && npm run lint && npm run build",
    "load-test": "tsx scripts/load-test-1000.mts",
    "load-test:db": "tsx scripts/load-test-db-only.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/react": "^4.0.140",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "ai": "^7.0.137",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "~19.1.2",
    "react-dom": "~19.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
